{
  "name": "@quickgui/native",
  "version": "0.1.3",
  "description": "Application, window, and platform APIs for natively compiled QuickGUI applications",
  "repository": {
    "type": "git",
    "url": "https://github.com/egoist/quickgui.git",
    "directory": "packages/native"
  },
  "bugs": "https://github.com/egoist/quickgui/issues",
  "homepage": "https://github.com/egoist/quickgui#readme",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./protocol": "./protocol.ts",
    "./native-tree": "./native-tree.ts",
    "./ffi": "./ffi.ts",
    "./ffi.json": "./ffi.json",

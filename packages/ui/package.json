    "./reactive": "./reactive.ts",
    "./style-table": "./style-table.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-runtime.ts",
    "./parts": "./parts.ts",
    "./router": "./router.ts",
    "./popover": "./popover.ts",
    "./controls": "./controls.ts",
    "./tabs": "./tabs.ts",
    "./disclosure": "./disclosure.ts",
    "./field": "./field.ts",
    "./dialog": "./dialog.ts",
    "./gauges": "./gauges.ts",
    "./range": "./range.ts",
    "./toolbar": "./toolbar.ts",
    "./menu": "./menu.ts",
    "./tooltip": "./tooltip.ts",
    "./toast": "./toast.ts",
    "./number-field": "./number-field.ts",
    "./select": "./select.ts",
    "./collections": "./collections.ts",
    "./date-time": "./date-time.ts",
    "./base-ui": "./base-ui.ts",
    "./types": "./types.ts",
    "./swift-ui": "./swift-ui.ts",
    "./swift-ui/modifiers": "./swift-ui/modifiers.ts"
  },
  "files": [
    "*.ts",
    "swift-ui",

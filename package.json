{
  "name": "quickgui-workspace",
  "version": "0.1.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "build:native": "bun run --filter @quickgui/native build",
    "test:js": "bun run modules:examples && bun test --conditions=browser ./packages/native ./packages/solid ./packages/cli ./examples/ai-chat-solid/history.test.ts ./examples/quick-git",
    "typecheck:js": "bunx tsc -p tsconfig.json --noEmit",
    "version:sync": "node scripts/sync-release-version.mjs",
    "version:check": "node scripts/sync-release-version.mjs --check",
    "modules:examples": "bun run --filter quick-git modules"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}

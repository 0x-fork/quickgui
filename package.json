{
  "name": "quickgui-js-workspace",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build:native": "bun run --filter @quickgui/native build",
    "test:js": "bun test --conditions=browser packages/native packages/solid packages/cli examples/ai-chat-solid/history.test.ts",
    "typecheck:js": "bunx tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}

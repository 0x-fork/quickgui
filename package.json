{
  "name": "quickgui-workspace",
  "version": "0.1.3",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "website"
  ],
  "scripts": {
    "build:native": "bun run --filter @quickgui/native build",
    "test:js": "bun test ./packages/cli",
    "typecheck:js": "bunx tsc -p tsconfig.json --noEmit",
    "version:sync": "node scripts/sync-release-version.mjs",
    "version:check": "node scripts/sync-release-version.mjs --check",
    "test:go": "bash scripts/check-go.sh",
    "fmt:go": "go -C go run ./cmd/quickguifmt -w ../go ../examples",
    "fmt:go:check": "go -C go run ./cmd/quickguifmt -check ../go ../examples"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "7.0.2",
    "@types/node": "^24.0.0"
  }
}
